# From your Supabase project: Project Settings → API Keys (or "Connect").
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Free app key from KLIPY, for GIF search. Optional: without it the GIF button is hidden.
VITE_KLIPY_APP_KEY=
# Free key from https://www.omdbapi.com/apikey.aspx (IMDb, Rotten Tomatoes, Metacritic scores).
# Optional: without it, Browse shows TMDB's score only.
VITE_OMDB_API_KEY=
